    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <div class="card p-4 col-md-6 mx-auto">
        <h3>Add sensor reading</h3>
        <form method="post">
            <input name="sensorId" class="form-control mb-2" placeholder="Sensor ID (e.g. sensor-01)" required />
            <select name="type" class="form-select mb-2">
                <option>moisture</option>
                <option>temperature</option>
                <option>irrigation</option>
            </select>
            <input name="value" type="number" step="0.01" class="form-control mb-3" placeholder="Value" required />
            <button class="btn btn-agri">Save</button>
        </form>
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success mt-3">@ViewBag.Message</div>
        }
    </div>
}
